<% layout("/layouts/boilerplate") %>
<body>
    <section class="listing-form-wrap">
        <div class="listing-form-header">
            <h2>Edit Listing</h2>
            <p>Refresh the details to keep your listing accurate.</p>
        </div>

        <form action="/listings/<%= listing._id %>?_method=PUT" method="post" class="listing-form">
            <div class="form-field">
                <label for="title">Title</label>
                <input type="text" id="title" name="title" value="<%= listing.title %>" required>
            </div>
            <div class="form-field">
                <label for="description">Description</label>
                <textarea id="description" name="description" rows="4" required><%= listing.description %></textarea>
            </div>
            <div class="form-field">
                <label for="price">Price</label>
                <input type="number" id="price" name="price" step="0.01" value="<%= listing.price %>" required>
            </div>
            <div class="form-field">
                <label for="location">Location</label>
                <input type="text" id="location" name="location" value="<%= listing.location %>" required>
            </div>
            <div class="form-field">
                <label for="country">Country</label>
                <input type="text" id="country" name="country" value="<%= listing.country %>" required>
            </div>
            <button type="submit" class="listing-form-submit">Update Listing</button>
        </form>
    </section>
</body>