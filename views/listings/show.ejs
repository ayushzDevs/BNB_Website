<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Listing by id</title>
</head>
<body>
    <h1><%= listings.id %></h1>
    <p><%= listings.title %></p>
    <p><%= listings.description %></p>
    <p>Price: <%= listings.price %></p>
    <p>Location: <%= listings.location %></p>
    <p>Country: <%= listings.country %></p>
</body>
</html>