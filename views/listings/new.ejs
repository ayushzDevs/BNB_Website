<% layout("/layouts/boilerplate") %>
<body>
    <section class="listing-form-wrap">
        <div class="listing-form-header">
            <h2>Create New Listing</h2>
            <p>Share the essentials so guests can find your space.</p>
        </div>

        <form action="/listings" method="post" class="listing-form">
            <div class="form-field">
                <label for="title">Title</label>
                <input type="text" id="title" name="title" placeholder="Cozy sunset studio" required>
            </div>
            <div class="form-field">
                <label for="description">Description</label>
                <textarea id="description" name="description" rows="4" placeholder="Describe the vibe, amenities, and what makes it special." required></textarea>
            </div>
            <div class="form-field">
                <label for="price">Price</label>
                <input type="number" id="price" name="price" step="0.01" placeholder="150" required>
            </div>
            <div class="form-field">
                <label for="location">Location</label>
                <input type="text" id="location" name="location" placeholder="Mumbai" required>
            </div>
            <div class="form-field">
                <label for="country">Country</label>
                <input type="text" id="country" name="country" placeholder="India" required>
            </div>
            <button type="submit" class="listing-form-submit">Create Listing</button>
        </form>
    </section>
</body>