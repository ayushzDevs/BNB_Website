<% layout("/layouts/boilerplate") %>
<body>
    <h2>BNB_Couples</h2>
    <div>
        <% allListings.forEach(listing=>{ %>
            <div style="border:1px solid black; margin:10px; padding:10px;">
                <h3><%= listing.title %></h3>
                <p><%= listing.description %></p>
                <p>Price : <%= listing.price %></p>
                <img src="<%= listing.image %>" alt="listing image" width="200px" height="200px">
                <br>
                <a href="/listings/<%= listing._id %>">show details</a>
                <br>
                <a href="/listings/new">create new listing</a>
                <br>
                <a href="/listings/<%= listing._id %>/edit">edit listing</a>
                <br>
                <form action="/listings/<%= listing._id %>?_method=DELETE" method="post" style="display:inline;">
                    <button type="submit">delete listing</button>
                </form>
            </div>
        <% }) %>
    </div>
</body>
