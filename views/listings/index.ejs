<% layout("/layouts/boilerplate") %>
<body>
    <b><h2>BNB_Couples</h2></b>
    <div class="row">
        
        <% allListings.forEach(listing=>{ %>
            <div class="card" style="width: 18rem; margin: 10px;">
                <img src="<%= listing.image %>" class="card-img-top" alt="<%= listing.title %>">
                <div class="card-body">
                    <h5 class="card-title"><%= listing.title %></h5>
                    <p class="card-text"><%= listing.description %></p>
                    <p class="card-text"><strong>Price: <%= listing.price %></strong></p>
                    <a href="/listings/<%= listing._id %>" class="btn btn-primary">Show Details</a>
                    <a href="/listings/<%= listing._id %>/edit" class="btn btn-warning">Edit</a>
                    <form action="/listings/<%= listing._id %>?_method=DELETE" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                </div>
            </div>
        <% }) %>
    </div>
</body>
